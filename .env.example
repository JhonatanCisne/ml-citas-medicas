# Variables para docker-compose. Copiar a ".env" en esta misma carpeta y ajustar.

# Django
SECRET_KEY=dev-local-clinica-secret
DEBUG=False
JWT_SECRET=dev-local-jwt-clinica
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost

# PostgreSQL
DB_NAME=clinica_ml
DB_USER=postgres
DB_PASSWORD=postgres123

# Frontend: URL del backend accesible desde el navegador (no la red interna de Docker)
VITE_API_URL=http://localhost:8000/api
